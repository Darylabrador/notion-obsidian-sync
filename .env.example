# =============================================================================
# notion-obsidian-sync configuration
#
# Copy this file to `.env` and fill in your values. Never commit `.env`.
# =============================================================================

# --- Notion ------------------------------------------------------------------

# Internal integration token from https://www.notion.so/my-integrations
# Grant it "Read content" only. Do NOT grant "Update content" / "Insert content".
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Obsidian ------------------------------------------------------------------

# Absolute path to your Obsidian vault.
# Linux example:   /home/user/Documents/MyVault
# Windows example: C:\Users\John\Documents\Obsidian\MyVault
OBSIDIAN_VAULT_PATH=/home/user/Documents/MyVault

# Subfolder inside the vault where synced notes are written. All writes and
# deletions performed by this tool are strictly confined to this folder.
OBSIDIAN_SYNC_FOLDER=Notion

# --- Page/database selection (fill in at least one of these) -----------------

# Mode A: sync a root page and all of its descendant pages.
NOTION_ROOT_PAGE_ID=

# Mode B: sync one or more databases (comma-separated database IDs).
NOTION_DATABASE_IDS=

# Mode C: when set, only database rows/pages whose checkbox property with this
# exact name is checked will be synced. Applies to NOTION_DATABASE_IDS only.
# Leave empty to sync every accessible row.
NOTION_SYNC_PROPERTY=Sync Obsidian

# --- Orphan handling -----------------------------------------------------------

# What to do with a previously-synced note whose Notion page has disappeared
# or become inaccessible. One of: keep | archive | delete
# "keep" never touches the file. "archive" moves it under _Archive/. "delete"
# permanently removes it. Default is the safest option.
ORPHAN_POLICY=keep

# --- Assets --------------------------------------------------------------------

DOWNLOAD_ASSETS=true

# Rewrite links between Notion pages into Obsidian [[wikilinks]].
CONVERT_NOTION_LINKS=true

# --- Scheduling ------------------------------------------------------------------

SYNC_INTERVAL_MINUTES=10

# --- Logging ---------------------------------------------------------------------

LOG_LEVEL=INFO

# --- Advanced (optional, sensible defaults are used if left empty) ---------------

# Notion API version header. Only change this if you know what you are doing.
# NOTION_API_VERSION=2025-09-03
